{{template "base" .}}

{{- /* create.gohtml — landing page and composer. The result replaces the form
       in place: navigating away and back would be a second chance to lose a
       link we cannot show again. */ -}}
{{define "create-content" -}}

<section class="hero wrap">
  <h1>{{call .T "create.h1.pre"}}<span class="mark-hl">{{call .T "create.h1.mark"}}</span>{{call .T "create.h1.post"}}</h1>
  <p class="lead hero__lead">{{call .T "create.lead"}}</p>
</section>

<div class="wrap">
  <div class="card card--wide card--bleed composer" id="composer">

    {{- if .ReadOnly}}
    <div class="callout callout--warning mb-5">
      {{template "icon-tools" "callout__icon"}}
      <span>{{call .T "create.readonly"}}</span>
    </div>
    {{- end}}

    <form id="create-form" novalidate aria-label="{{call .T "create.form_aria"}}">

      <div class="composer__head">
        <div class="seg" role="tablist" aria-label="{{call .T "create.tablist_aria"}}">
          <button type="button" class="seg__btn" role="tab" id="tab-text"
                  aria-selected="true" aria-controls="panel-text" data-tab="text">
            {{template "icon-text" "chip__icon"}}{{call .T "create.tab.text"}}
          </button>
          <button type="button" class="seg__btn" role="tab" id="tab-file"
                  aria-selected="false" aria-controls="panel-file" data-tab="file"
                  tabindex="-1"{{if not .FilesEnabled}} disabled{{end}}>
            {{template "icon-file" "chip__icon"}}{{call .T "create.tab.file"}}
          </button>
        </div>
        {{- /* Stays invisible until the input is long enough to be worth
               counting; see composer__counter in app.css. */}}
        <span class="composer__counter" id="text-counter" aria-hidden="true">0</span>
      </div>

      <div id="panel-text" role="tabpanel" aria-labelledby="tab-text" tabindex="0">
        <label class="sr-only" for="secret-text">{{call .T "create.textarea.label"}}</label>
        <textarea class="textarea textarea--mono" id="secret-text" name="secret"
                  autofocus autocomplete="off" autocapitalize="off" autocorrect="off"
                  spellcheck="false" aria-describedby="text-hint"
                  placeholder="{{call .T "create.textarea.placeholder"}}"></textarea>
        <p class="hint" id="text-hint">{{call .T "create.textarea.hint"}}</p>
      </div>

      <div id="panel-file" role="tabpanel" aria-labelledby="tab-file" tabindex="0" class="is-hidden">
        {{- if .FilesEnabled}}
        <div class="drop" id="drop-zone">
          {{template "icon-upload" "filerow__icon"}}
          <p class="drop__title">{{call .T "create.file.drop"}}</p>
          <p class="drop__or">{{call .T "create.file.or"}}</p>
          <button type="button" class="btn btn--ghost" id="file-pick">
            {{call .T "create.file.pick"}} <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <p class="hint">{{call .T "create.file.max"}} {{bytes .MaxFileBytes}}</p>
          <input type="file" id="secret-file" name="file" class="sr-only" tabindex="-1">
        </div>
        <div class="filerow is-hidden" id="file-row">
          {{template "icon-file" "filerow__icon"}}
          <span class="filerow__name" id="file-name"></span>
          <span class="filerow__size mono" id="file-size"></span>
          <button type="button" class="filerow__remove" id="file-remove"
                  aria-label="{{call .T "create.file.remove"}}">
            {{template "icon-close" ""}}
          </button>
        </div>
        {{- else}}
        <div class="callout callout--warning">
          {{template "icon-warning" "callout__icon"}}
          <span>{{call .T "create.file.disabled"}}</span>
        </div>
        {{- end}}
      </div>

      {{- /* Native <details>: the disclosure works with no JS, and the arrow
             keys inside the radiogroup are the browser's, not ours. */}}
      <details class="details mt-5" id="options">
        <summary class="details__summary">
          {{template "icon-chevron" "details__chevron"}}
          <span>{{call .T "create.options.summary"}}</span>
          <span class="details__value" id="options-summary"></span>
        </summary>
        <div class="details__body">

          <fieldset class="field fieldset-bare">
            <legend class="label-mono" id="ttl-label">{{call .T "create.ttl.label"}}</legend>
            <div class="chips" role="radiogroup" aria-labelledby="ttl-label" id="ttl-chips">
              <label class="chip chip--radio">
                <input type="radio" name="ttl_days" value="1"{{if eq .TTLDefault 1}} checked{{end}}>
                <span>{{call .T "create.ttl.d1"}}</span>
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="ttl_days" value="7"{{if eq .TTLDefault 7}} checked{{end}}>
                <span>{{call .T "create.ttl.d7"}}</span>
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="ttl_days" value="14"{{if eq .TTLDefault 14}} checked{{end}}>
                <span>{{call .T "create.ttl.d14"}}</span>
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="ttl_days" value="30"{{if eq .TTLDefault 30}} checked{{end}}>
                <span>{{call .T "create.ttl.d30"}}</span>
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="ttl_days" value="custom" id="ttl-custom-radio">
                <span>{{call .T "create.ttl.custom"}}</span>
              </label>
            </div>

            <div class="input-group is-hidden mt-1" id="ttl-custom-wrap">
              <label class="sr-only" for="ttl-custom">{{printf (call .T "create.ttl.custom_label") .TTLMin .TTLMax}}</label>
              <input type="number" class="input input--number input--mono" id="ttl-custom"
                     min="{{.TTLMin}}" max="{{.TTLMax}}" step="1" value="{{.TTLDefault}}"
                     inputmode="numeric">
              <span class="hint m-0">{{printf (call .T "create.ttl.custom_label") .TTLMin .TTLMax}}</span>
              {{- /* The custom field replaces the chips, so without this there
                     is no route back to the presets. */}}
              <button type="button" class="btn btn--ghost btn--small" id="ttl-back">
                {{call .T "create.ttl.back"}}
              </button>
            </div>

            <p class="hint" id="ttl-computed"></p>
          </fieldset>

          <hr class="hairline">

          <div class="field">
            <label class="label-mono" for="passphrase">{{call .T "create.pass.label"}}</label>
            <div class="input-group">
              <input type="password" class="input" id="passphrase" name="passphrase"
                     autocomplete="new-password" autocapitalize="off" autocorrect="off"
                     spellcheck="false" placeholder="{{call .T "create.pass.placeholder"}}"
                     aria-describedby="pass-hint">
              <button type="button" class="icon-btn" id="pass-toggle"
                      aria-pressed="false" aria-label="{{call .T "create.pass.show"}}">
                {{template "icon-eye" ""}}
              </button>
              <button type="button" class="btn btn--ghost btn--small" id="pass-generate">
                {{call .T "create.pass.generate"}}
              </button>
            </div>
            <p class="hint" id="pass-hint">{{call .T "create.pass.hint"}}</p>
          </div>

        </div>
      </details>

      <p class="form-error is-hidden mt-4" id="form-error">
        {{template "icon-close" "form-error__icon"}}
        <span id="form-error-text"></span>
      </p>

      <div class="btn-row sticky-cta mt-5" id="submit-row">
        <button type="submit" class="btn btn--primary btn--cta" id="submit"
                aria-keyshortcuts="Meta+Enter Control+Enter"
                {{if .ReadOnly}}disabled{{end}}>
          <span id="submit-label">{{call .T "create.submit"}}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>

      {{- /* Replaces the button during an upload — a bar that is only visible
             next to the control it blocks is easy to miss. */}}
      <div class="progress is-hidden mt-5" id="upload-progress">
        <div class="progress__track">
          <div class="progress__bar" id="progress-bar" role="progressbar"
               aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"
               aria-label="{{call .T "create.upload.aria"}}"></div>
        </div>
        <p class="progress__meta">
          <span id="progress-text">{{call .T "js.uploading"}}</span>
          <button type="button" class="progress__cancel" id="progress-cancel">
            {{call .T "js.upload_cancel"}}
          </button>
        </p>
      </div>

    </form>

    {{- /* Result state. Swapped in without navigating: the link exists in this
           tab and nowhere else. */}}
    {{- /* h1, not h2: while the result is showing, the hero above it — and with
           it the page's other h1 — is hidden, so this is the only heading that
           describes the page. */}}
    <div id="result" class="is-hidden" tabindex="-1">
      <span class="result__icon">{{template "icon-check" ""}}</span>
      <h1 id="result-title">{{call .T "create.result.title"}}</h1>

      <div class="field mt-5">
        <label class="label-mono" for="result-url">{{call .T "create.result.label"}}</label>
        <div class="linkbox">
          <input type="text" class="input input--mono" id="result-url" readonly
                 spellcheck="false" value="">
        </div>
      </div>

      {{- /* The retention sits beside the button rather than under it. A chip
             is the visual form for a group of equal labels and on its own reads
             as the leftover of a row that is gone; as quiet text on the button's
             own line it is available without competing for attention, and the
             card loses a stacked row. Filled in by JS. */}}
      <div class="btn-row btn-row--baseline mt-4">
        <button type="button" class="btn btn--primary" id="copy-link">
          <span id="copy-link-label">{{call .T "create.result.copy"}}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <p class="hint" id="result-expiry"></p>
      </div>

      <div class="callout callout--warning mt-5">
        {{template "icon-warning" "callout__icon"}}
        <span>{{call .T "create.result.warn"}}</span>
      </div>
    </div>

  </div>
</div>

<section class="navy" id="how">
  <div class="wrap">
    <p class="kicker">{{call .T "create.how.kicker"}}</p>
    <h2>{{call .T "create.how.h2.pre"}}<span class="mark-hl">{{call .T "create.how.h2.mark"}}</span>{{call .T "create.how.h2.post"}}</h2>
    <div class="glass-grid">
      <div class="glass-card">
        <span class="glass-card__num">01</span>
        <h3>{{call .T "create.how.1.title"}}</h3>
        <p>{{call .T "create.how.1.body"}}</p>
      </div>
      <div class="glass-card">
        <span class="glass-card__num">02</span>
        <h3>{{call .T "create.how.2.title"}}</h3>
        <p>{{call .T "create.how.2.body"}}</p>
      </div>
      <div class="glass-card">
        <span class="glass-card__num">03</span>
        <h3>{{call .T "create.how.3.title"}}</h3>
        <p>{{call .T "create.how.3.body"}}</p>
      </div>
    </div>
  </div>
</section>

{{- end}}
