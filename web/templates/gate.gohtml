{{template "base" .}}

{{- /* gate.gohtml — the recipient's page.

       The server has no key, so this document is only a shell: everything it
       shows comes from POST /api/v1/peek, which the browser calls with the URL
       fragment. That is what makes link previews harmless — a prefetcher that
       fetches GET /s/<id> gets this shell and burns nothing, because the burn
       only happens on an explicit POST /api/v1/reveal.

       Every state below is rendered up front and toggled by JS, so the strings
       stay in the Go catalog rather than being shipped as JSON. */ -}}
{{define "gate-content" -}}

<div class="wrap gate__inner">

  <noscript>
    <div class="callout callout--warning noscript">
      {{template "icon-warning" "callout__icon"}}
      <span>{{call .T "gate.noscript"}}</span>
    </div>
  </noscript>

  {{- /* 1. While /peek is in flight. */}}
  <p class="lead" id="gate-loading">{{call .T "gate.loading"}}</p>

  {{- /* 2. The decision. */}}
  <div id="gate-intro" class="is-hidden">
    <span class="gate__icon">{{template "icon-lock" ""}}</span>

    {{- /* The heading names what happened, not what to do. */}}
    <h2>
      <span id="gate-h2-text">{{call .T "gate.h2.text"}}</span>
      <span id="gate-h2-file" class="is-hidden">{{call .T "gate.h2.file"}}</span>
    </h2>
    <p class="lead mt-4">{{call .T "gate.lead"}}</p>

    {{- /* Evidence that the link is real: a phishing page cannot say what is
           inside without having fetched it. */}}
    <ul class="chips gate__chips" id="gate-chips">
      <li class="chip chip--meta is-hidden" id="chip-kind-text">
        {{template "icon-text" "chip__icon"}}{{call .T "gate.chip.text"}}
      </li>
      <li class="chip chip--meta is-hidden" id="chip-kind-file">
        {{template "icon-file" "chip__icon"}}{{call .T "gate.chip.file"}}
      </li>
      <li class="chip chip--meta is-hidden" id="chip-size"><span id="chip-size-text"></span></li>
      <li class="chip chip--meta is-hidden" id="chip-expires">
        {{template "icon-clock" "chip__icon"}}<span id="chip-expires-text"></span>
      </li>
      {{- /* Announced before the click, so that being asked for a password is
             never a surprise. */}}
      <li class="chip chip--warning is-hidden" id="chip-pass">
        {{template "icon-key" "chip__icon"}}{{call .T "gate.chip.protected"}}
      </li>
    </ul>

    <div class="gate__cta">
      <button type="button" class="btn btn--primary btn--tall btn--block" id="gate-reveal"
              aria-keyshortcuts="Meta+Enter Control+Enter">
        <span id="gate-cta-label" data-plain="{{call .T "gate.cta"}}" data-pass="{{call .T "gate.cta_pass"}}">{{call .T "gate.cta"}}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
      <p class="gate__cta-hint">{{call .T "gate.cta_hint"}}</p>
    </div>

    {{- /* Hidden by default: most people click without reading, and that is
           fine. The sceptical one gets the answer in a single click. */}}
    <details class="disclosure gate__why">
      <summary>{{template "icon-chevron" "details__chevron"}}{{call .T "gate.why.summary"}}</summary>
      <p class="disclosure__body">{{call .T "gate.why.body"}}</p>
    </details>
  </div>

  {{- /* 3. Passphrase step. */}}
  <div id="gate-pass" class="is-hidden">
    <span class="gate__icon gate__icon--key">{{template "icon-key" ""}}</span>
    <h2>{{call .T "gate.pass.h2"}}</h2>
    <p class="lead mt-4">{{call .T "gate.pass.lead"}}</p>

    <form id="pass-form" class="mt-6">
      <label class="sr-only" for="gate-pass-input">{{call .T "gate.pass.label"}}</label>
      <input type="password" class="input" id="gate-pass-input" autocomplete="off"
             autocapitalize="off" autocorrect="off" spellcheck="false"
             enterkeyhint="go" aria-describedby="pass-attempts"
             placeholder="{{call .T "gate.pass.placeholder"}}">

      <p class="form-error is-hidden mt-3" id="pass-error" role="alert">
        {{template "icon-close" "form-error__icon"}}
        <span id="pass-error-text"></span>
      </p>

      <button type="submit" class="btn btn--primary btn--tall btn--block mt-4" id="pass-submit">
        <span id="pass-submit-label">{{call .T "gate.pass.cta"}}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
      <p class="hint" id="pass-attempts"></p>
    </form>
  </div>

  {{- /* 4. Revealed. */}}
  <div id="gate-revealed" class="is-hidden">
    {{- /* One message, not two. That we deleted our copy is our business; what
           the recipient has to act on is that this page is the only copy left,
           so it goes above the content, before they can close the tab. */}}
    <div class="callout callout--warning">
      {{template "icon-warning" "callout__icon"}}
      <span>{{call .T "gate.revealed.warn"}}</span>
    </div>

    <div id="reveal-text-wrap" class="is-hidden mt-5">
      {{- /* Not inside a live region: an assistive technology must not read a
             one-time secret aloud on its own. The announcement in #sr-status
             says that content appeared, never what it is. */}}
      <pre id="secret-out" class="secret" tabindex="0" role="region"
           aria-label="{{call .T "gate.revealed.aria"}}"></pre>
      <div class="btn-row mt-4">
        <button type="button" class="btn btn--primary" id="copy-secret">
          <span id="copy-secret-label">{{call .T "gate.revealed.copy"}}</span>
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>

    <div id="reveal-file-wrap" class="is-hidden mt-5">
      {{- /* In-app browsers silently drop programmatic downloads, so say so
             before the button is pressed rather than after it fails. */}}
      <div class="callout callout--info is-hidden mb-4" id="inapp-hint">
        {{template "icon-info" "callout__icon"}}
        <span>{{call .T "gate.file.inapp"}}</span>
      </div>
      <div class="filerow">
        {{template "icon-file" "filerow__icon"}}
        <span class="filerow__name" id="dl-name"></span>
        <span class="filerow__size mono" id="dl-size"></span>
      </div>
      {{- /* Never auto-started: on mobile an automatic download is confusing
             and in an in-app browser it fails without a word. */}}
      <button type="button" class="btn btn--primary btn--tall btn--block mt-4" id="download-btn">
        <span id="download-label">{{call .T "gate.file.download"}}</span>
        <span class="btn__arrow" aria-hidden="true">→</span>
      </button>
      <p class="hint is-hidden" id="download-done">{{call .T "gate.file.downloaded"}}</p>
    </div>

    <p class="mt-6">
      {{call .T "gate.revealed.loop"}}
      <a href="/">{{call .T "gate.revealed.loop_cta"}} <span class="btn__arrow" aria-hidden="true">→</span></a>
    </p>
  </div>

  {{- /* 5. Dead end — link already used, expired, key missing, and so on. */}}
  <div id="gate-status" class="is-hidden">
    <span class="status__icon" id="gate-status-icon">{{template "icon-question" ""}}</span>
    <h2 id="gate-status-title"></h2>
    <p class="lead mt-4" id="gate-status-body"></p>
    <p class="status__cta">
      <a class="btn btn--primary" href="/">{{call .T "status.cta"}}
        <span class="btn__arrow" aria-hidden="true">→</span></a>
    </p>
  </div>

  {{- /* Text for the dead ends, rendered by Go so the wording lives in one
         catalog instead of being duplicated as js.* keys. JS copies the title,
         the body and the icon out of here. */}}
  <div id="status-catalog" class="is-hidden" aria-hidden="true">
    <div data-variant="missing_key" data-tone="warning">
      <span data-title>{{call .T "status.missing_key.title"}}</span>
      <span data-body>{{call .T "status.missing_key.body"}}</span>
      <span data-icon>{{template "icon-warning" ""}}</span>
    </div>
    <div data-variant="not_found" data-tone="muted">
      <span data-title>{{call .T "status.not_found.title"}}</span>
      <span data-body>{{call .T "status.not_found.body"}}</span>
      <span data-icon>{{template "icon-question" ""}}</span>
    </div>
    <div data-variant="already_revealed" data-tone="muted">
      <span data-title>{{call .T "status.already_read.title"}}</span>
      <span data-body>{{call .T "status.already_read.body"}}</span>
      <span data-icon>{{template "icon-check" ""}}</span>
    </div>
    <div data-variant="burned" data-tone="muted">
      <span data-title>{{call .T "status.burned.title"}}</span>
      <span data-body>{{call .T "status.burned.body"}}</span>
      <span data-icon>{{template "icon-ban" ""}}</span>
    </div>
    <div data-variant="destroyed" data-tone="danger">
      <span data-title>{{call .T "status.destroyed.title"}}</span>
      <span data-body>{{call .T "status.destroyed.body"}}</span>
      <span data-icon>{{template "icon-lock" ""}}</span>
    </div>
    {{- /* Not "destroyed": five wrong passwords in a row only lock the link
           for twenty minutes, and the content is still there. Telling the
           recipient it was deleted sends them away from a link that works. */}}
    <div data-variant="too_many_attempts" data-tone="warning">
      <span data-title>{{call .T "status.too_many_attempts.title"}}</span>
      <span data-body>{{call .T "status.too_many_attempts.body"}}</span>
      <span data-icon>{{template "icon-pause" ""}}</span>
    </div>
    <div data-variant="expired" data-tone="warning">
      <span data-title>{{call .T "status.expired.title"}}</span>
      <span data-body>{{call .T "status.expired.body"}}</span>
      <span data-icon>{{template "icon-clock" ""}}</span>
    </div>
    <div data-variant="rate_limited" data-tone="warning">
      <span data-title>{{call .T "status.rate_limited.title"}}</span>
      <span data-body>{{call .T "status.rate_limited.body"}}</span>
      <span data-icon>{{template "icon-pause" ""}}</span>
    </div>
    <div data-variant="server_error" data-tone="danger">
      <span data-title>{{call .T "status.server_error.title"}}</span>
      <span data-body>{{call .T "status.server_error.body"}}</span>
      <span data-icon>{{template "icon-bolt" ""}}</span>
    </div>
  </div>

</div>

{{- end}}
